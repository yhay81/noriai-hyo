{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noriai-hyo",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "noriai-hyo.yhay81.com",
      "custom_domain": true,
    },
  ],
  "triggers": {
    "crons": ["37 18 * * *"],
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "noriai-hyo",
      "database_id": "692be889-b533-4005-8e7b-a0906c8b704b",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
}
